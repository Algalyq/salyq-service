# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://192.168.0.2:3000

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Kalkan Validation Service
KALKAN_URL=http://localhost:8001

# KGD Smart Bridge (disabled by default — requires agreement with KGD)
# To enable: set KGD_SMARTBRIDGE_ENABLED=true and fill credentials
KGD_SMARTBRIDGE_ENABLED=false
KGD_SENDER_ID=
KGD_SENDER_PASSWORD=
KGD_SERVICE_KEY=FNO_INTEGRATION_STATUS
